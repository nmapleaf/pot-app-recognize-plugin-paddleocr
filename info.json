{
  "id": "plugin.com.pot-app.paddleocr",
  "plugin_type": "recognize",
  "icon": "icon.png",
  "display": "PaddleOCR",
  "homepage": "https://github.com/pot-app/pot-app-recognize-plugin-paddleocr",
  "needs": [
    {
      "key": "accessToken",
      "display": "Access Token",
      "type": "input"
    },
    {
      "key": "model",
      "display": "Model",
      "type": "input"
    },
    {
      "key": "returnFormat",
      "display": "返回格式",
      "type": "select",
      "options": {
        "plain": "纯文本（推荐）",
        "markdown": "Markdown（保留表格/版面）"
      }
    },
    {
      "key": "pollIntervalSeconds",
      "display": "轮询间隔",
      "type": "select",
      "options": {
        "3": "3 秒",
        "5": "5 秒（推荐）",
        "10": "10 秒"
      }
    },
    {
      "key": "timeoutSeconds",
      "display": "任务超时",
      "type": "select",
      "options": {
        "60": "60 秒",
        "120": "120 秒（推荐）",
        "300": "300 秒"
      }
    },
    {
      "key": "useDocOrientationClassify",
      "display": "方向分类",
      "type": "select",
      "options": {
        "false": "关闭（推荐）",
        "true": "开启"
      }
    },
    {
      "key": "useDocUnwarping",
      "display": "文档矫正",
      "type": "select",
      "options": {
        "false": "关闭（推荐）",
        "true": "开启"
      }
    },
    {
      "key": "useChartRecognition",
      "display": "图表识别",
      "type": "select",
      "options": {
        "false": "关闭（推荐）",
        "true": "开启"
      }
    }
  ],
  "language": {
    "auto": "auto",
    "zh_cn": "zh_cn",
    "zh_tw": "zh_tw",
    "yue": "yue",
    "en": "en",
    "ja": "ja",
    "ko": "ko",
    "fr": "fr",
    "es": "es",
    "ru": "ru",
    "de": "de",
    "it": "it",
    "tr": "tr",
    "pt_pt": "pt",
    "pt_br": "pt",
    "vi": "vi",
    "id": "id",
    "th": "th",
    "ms": "ms",
    "ar": "ar",
    "hi": "hi",
    "mn_mo": "mn",
    "mn_cy": "mn",
    "km": "km",
    "nb_no": "nb",
    "nn_no": "nn",
    "fa": "fa",
    "sv": "sv",
    "pl": "pl",
    "nl": "nl",
    "uk": "uk"
  }
}
